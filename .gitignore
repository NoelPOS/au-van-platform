# Local configuration and secrets
.env
.env.*
!.env.example

# Editor and operating-system files
.DS_Store
.idea/
.vscode/

# Build output and dependencies
node_modules/
dist/
build/
target/
coverage/
playwright-report/
test-results/

# Terraform working directories, state, and real variable values
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log
crash.*.log

# Tracked on purpose: the placeholder variable files and the provider lock,
# so that everyone resolves the same provider build.
!*.tfvars.example
!.terraform.lock.hcl

# Machine-specific Claude Code settings
.claude/settings.local.json

# Per-track git worktrees
.worktrees/

# Database dumps written by deploy/backup.sh on the server
/backups/

# Locally installed agent skills
.agents/
skills-lock.json
