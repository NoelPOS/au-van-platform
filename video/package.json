{
  "name": "video",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "assets": "mkdir -p public && cp ../web/public/landing/*.webp public/",
    "render": "remotion render src/index.ts Intro out/intro.mp4 --codec=h264 --crf=23 --muted --concurrency=1 --timeout=120000",
    "poster": "remotion still src/index.ts Intro out/video-poster.webp --frame=849 --timeout=120000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@remotion/cli": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  }
}
