{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git revert:*)",
      "Bash(git stash:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh project:*)",
      "Bash(gh label:*)",
      "Bash(gh run:*)",
      "Bash(gh api repos/NoelPOS/au-van-platform*)",
      "Bash(./gradlew:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(docker compose:*)",
      "Bash(scripts/setup-hooks.sh:*)",
      "Bash(git push --force-with-lease:*)"
    ],
    "ask": [
      "Bash(aws:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.local.*)",
      "Write(./**/.env)",
      "Write(./**/.env.local)",
      "Write(./**/.env.local.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.local.*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh workflow run:*)"
    ]
  }
}
