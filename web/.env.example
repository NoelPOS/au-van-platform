# Use http://localhost:8080 for direct local-browser testing.
# Leave blank when testing through a public Vite tunnel so /api uses the Vite proxy.
VITE_API_BASE_URL=http://localhost:8080
# LIFF ID only; do not place LINE channel secrets in this client-side file.
VITE_LIFF_ID=
# The Official Account's basic ID, such as @123abcde. Shows students an
# "Add AU-Van on LINE" prompt when they have not added it; blank hides it.
VITE_LINE_OA_ID=
# Leave this empty. Set to "true" only by compose.e2e.yaml, which builds the
# web image for the Playwright suite: it adds a sign-in control that posts a
# chosen subject to the exchange endpoint instead of going through LINE
# (ADR-013). Setting it here would put that control in your own dev server,
# where the API still refuses the subject, and a build with it set is checked
# for and rejected by CI's bundle grep.
VITE_E2E_AUTH=
