# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
# Every value below is the module default, except api_image_tag, which has no
# default at all: it carries a replace-me value below and an apply fails until
# the operator supplies it. The file exists to show what is adjustable. No
# secret is set here or anywhere else in this repository: the database password
# is RDS-managed and JWT_SECRET and LINE_CHANNEL_ACCESS_TOKEN are SecureString
# parameters the owner creates by hand before the first apply (ADR-012, and
# `terraform output required_ssm_parameters` for their names).
#
# CORS_ALLOWED_ORIGINS is no longer a variable. #80 put a CloudFront
# distribution in front of both the web build and /api/*, so the API's allowed
# origin is that distribution's own domain and compute.tf composes it from the
# resource -- there is nothing for an operator to get wrong and nothing to
# update on a second pass.
aws_region   = "ap-southeast-1"
project_name = "au-van"
environment  = "demo"

vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.0.0/24", "10.20.1.0/24"]

# The load balancer admits CloudFront and nothing else, which is what makes it
# safe for the demo to be reachable at all. Leave the range list empty: an
# entry here is a second way to the origin that skips CloudFront, in plaintext,
# while the request carries a JWT. Turning the prefix list off without putting
# a range in its place leaves the load balancer admitting nothing.
load_balancer_ingress_cidrs                = []
load_balancer_allow_cloudfront_prefix_list = true

app_port      = 8080
database_port = 5432

# The image tag to deploy. No default: name the build, not a floating tag.
api_image_tag = "replace-me"

db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_engine_version    = "17"
db_multi_az          = false

enable_redis    = false
redis_node_type = "cache.t4g.micro"

task_cpu      = 512
task_memory   = 1024
desired_count = 1

# A LINE Login channel id -- an audience identifier, not a credential. Empty
# leaves the LIFF exchange unconfigured.
line_channel_id = ""

# Empty creates no SNS topic and no subscription; the alarms still show their
# state.
alarm_notification_email = ""

log_retention_days   = 7
ssm_parameter_prefix = "/au-van/demo"
