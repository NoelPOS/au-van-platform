# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
# Every value below is the module default; the file exists to show what is
# adjustable. load_balancer_ingress_cidrs is open, which is only tolerable
# while this module creates no load balancer -- see its description in
# variables.tf for how #11b must narrow it.
aws_region   = "ap-southeast-1"
project_name = "au-van"
environment  = "demo"

vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.0.0/24", "10.20.1.0/24"]

load_balancer_ingress_cidrs = ["0.0.0.0/0"]

app_port      = 8080
database_port = 5432
