# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
# Every value below is the module default; the file exists to show what is
# adjustable. Narrowing load_balancer_ingress_cidrs to your own address is the
# one change worth making before a real demo.
aws_region   = "ap-southeast-1"
project_name = "au-van"
environment  = "demo"

vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.0.0/24", "10.20.1.0/24"]

load_balancer_ingress_cidrs = ["0.0.0.0/0"]

app_port      = 8080
database_port = 5432
