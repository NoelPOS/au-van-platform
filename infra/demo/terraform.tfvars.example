# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
# Every value below is the module default, except api_image_tag and
# cors_allowed_origins, which have no default at all -- both carry a
# replace-me value below and an apply fails until the operator supplies them.
# Neither is knowable before the first apply, so the first deployment is two
# passes; infra/README.md gives the order. The
# file exists to show what is adjustable. No secret is set here or anywhere
# else in this repository: the database password is RDS-managed and JWT_SECRET
# and LINE_CHANNEL_ACCESS_TOKEN are SecureString parameters the owner creates
# by hand before the first apply (ADR-012, and `terraform output
# required_ssm_parameters` for their names).
#
# load_balancer_ingress_cidrs is open. Now that this module creates a load
# balancer there is something behind that range, so it is this module's known
# exposure rather than a hypothetical one, and it stays open until #75b narrows
# it to the CloudFront origin-facing prefix list -- see its description in
# variables.tf. Do not leave the module applied and unattended meanwhile.
aws_region   = "ap-southeast-1"
project_name = "au-van"
environment  = "demo"

vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.0.0/24", "10.20.1.0/24"]

load_balancer_ingress_cidrs = ["0.0.0.0/0"]

app_port      = 8080
database_port = 5432

# The image tag to deploy. No default: name the build, not a floating tag.
api_image_tag = "replace-me"

db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_engine_version    = "17"
db_multi_az          = false

enable_redis    = false
redis_node_type = "cache.t4g.micro"

task_cpu      = 512
task_memory   = 1024
desired_count = 1

# A LINE Login channel id -- an audience identifier, not a credential. Empty
# leaves the LIFF exchange unconfigured.
line_channel_id = ""

# REPLACE-ME. No default, and empty is not a safe stand-in: a browser sends
# Origin on every non-GET/HEAD request even to its own origin, so an empty list
# makes the API answer 403 to every POST. Use the origin the browser loads the
# app from -- http://<the load_balancer_dns_name output> while this module is
# all there is, and https://<distribution domain> once #75b's CloudFront
# distribution fronts both the web build and /api/*.
cors_allowed_origins = "http://replace-me.ap-southeast-1.elb.amazonaws.com"

# Empty creates no SNS topic and no subscription; the alarms still show their
# state.
alarm_notification_email = ""

log_retention_days   = 7
ssm_parameter_prefix = "/au-van/demo"
