#!/bin/sh
# Enforces the AU-Van commit convention: a single Conventional Commits subject
# line, with no body and no trailers. See AGENTS.md, "Naming and review
# conventions".
#
# This hook is fast local feedback; the "Commit checks" CI job, a required
# status check on main, runs the same rules and is what actually gates a merge.
# Install locally with scripts/setup-hooks.sh.
#
# Scope: this catches attribution as tooling emits it and as a person would
# plausibly type it. It is a substring match, so it does not resist deliberate
# obfuscation — homoglyphs, zero-width characters, and novel phrasings get past
# it, and anyone who can edit this file defeats it outright, since CI runs the
# branch's own copy. Deliberate attribution is caught by review of the diff.

message_file="$1"

# Two views of the message.
#
# "authored" is what the author actually wrote, minus the diff that
# `git commit -v` appends below git's scissors line. Comments are KEPT, because
# `git commit -m` uses cleanup=whitespace and stores a '#'-prefixed line
# verbatim — so a comment is a real place attribution can hide.
#
# "body" is what git will store for an editor commit, with comments removed.
# The shape rules use it so git's own template does not look like a body.
authored=$(sed '/^#.*>8/,$d' "$message_file")
body=$(printf '%s\n' "$authored" | grep -v '^#')
subject=$(printf '%s\n' "$body" | head -n 1)

fail() {
    echo "commit-msg: $1" >&2
    echo "commit-msg: see AGENTS.md for the commit convention." >&2
    exit 1
}

# Attribution is checked on every message, with no exemptions. A subject that
# merely looks git-generated must not be a way past this.
#
# The patterns are deliberately broad. The attribution this project must keep
# out is emitted as "Generated with [Claude Code](https://claude.com/claude-code)",
# so a narrow literal match misses it the moment the wording or markup shifts.
if printf '%s\n' "$authored" | grep -Eqi '^[[:space:]]*[A-Za-z][A-Za-z0-9-]*-[Bb]y:'; then
    fail "commit messages carry no attribution trailer."
fi

if printf '%s\n' "$authored" | grep -Eqi 'claude[^a-z0-9]{0,3}code|claude\.com|anthropic|generated (with|by|using) claude'; then
    fail "commit messages carry no tool attribution."
fi

# Messages git writes itself legitimately carry a body and a non-Conventional
# subject, so they skip the shape rules below — but only these exact shapes.
case "$subject" in
    'fixup! '*|'squash! '*)
        exit 0
        ;;
    'Merge branch '*|'Merge remote-tracking branch '*|'Merge tag '*)
        exit 0
        ;;
esac

# GitHub's pull-request merge ref, which the CI job checks out.
if printf '%s' "$subject" | grep -Eq '^Merge [0-9a-f]{7,40} into [0-9a-f]{7,40}$'; then
    exit 0
fi

# git revert --no-edit, identified by the trailer git appends, not by subject.
if printf '%s' "$subject" | grep -q '^Revert "'; then
    if printf '%s\n' "$body" | grep -Eq '^This reverts commit [0-9a-f]{40}\.$'; then
        exit 0
    fi
    fail "a Revert subject is only accepted on a message git generated; write 'revert(scope): outcome' instead."
fi

if [ "$(printf '%s\n' "$body" | wc -l | tr -d ' ')" -gt 1 ]; then
    fail "commit messages are a single subject line with no body."
fi

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|chore|refactor|test|perf|build|ci|style|revert)(\([a-z0-9-]+\))?!?: ([a-z0-9]|[a-z0-9].*[^.])$'; then
    fail "subject must be Conventional Commits, lower-case, no trailing period: 'type(scope): imperative outcome'."
fi

if [ "${#subject}" -gt 72 ]; then
    fail "subject is ${#subject} characters; keep it to 72 or fewer."
fi
