#!/bin/sh
# Enforces the AU-Van commit convention: a single Conventional Commits subject
# line, with no body and no trailers. See AGENTS.md, "Naming and review
# conventions".

message_file="$1"

# Strip comment lines and trailing blank lines.
body=$(grep -v '^#' "$message_file" | sed -e :a -e '/^\n*$/{$d;N;};/\n$/ba')

fail() {
    echo "commit-msg: $1" >&2
    echo "commit-msg: see AGENTS.md for the commit convention." >&2
    exit 1
}

if printf '%s' "$body" | grep -qi '^co-authored-by:'; then
    fail "commit messages carry no Co-Authored-By trailer."
fi

if printf '%s' "$body" | grep -qi 'generated with'; then
    fail "commit messages carry no tool attribution."
fi

if [ "$(printf '%s\n' "$body" | wc -l | tr -d ' ')" -gt 1 ]; then
    fail "commit messages are a single subject line with no body."
fi

subject=$(printf '%s' "$body" | head -n 1)

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|chore|refactor|test|perf|build|ci|style|revert)(\([a-z0-9-]+\))?: [a-z].*[^.]$'; then
    fail "subject must be Conventional Commits, lower-case, no trailing period: 'type(scope): imperative outcome'."
fi

if [ "${#subject}" -gt 72 ]; then
    fail "subject is ${#subject} characters; keep it under 72."
fi
