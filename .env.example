POSTGRES_DB=au_van
POSTGRES_USER=au_van
# Add POSTGRES_PASSWORD to your ignored .env file with a locally generated value.
# Add a base64-encoded 32-byte JWT_SECRET generated with: openssl rand -base64 32
# Add LINE_CHANNEL_ID when testing the live LIFF exchange.
POSTGRES_PASSWORD=
JWT_SECRET=
LINE_CHANNEL_ID=
# A LINE MESSAGING API channel credential, and a DIFFERENT channel from
# LINE_CHANNEL_ID above, which is a LINE Login channel. Create the Messaging
# channel under the SAME LINE provider as the Login channel: if it is under a
# different one, the user id this system stores from the Login channel is not a
# valid push target and every notification fails with a recipient error that
# looks exactly like a bug in the API. See README.md, "LINE Messaging".
# Neither ./gradlew test nor CI needs this; only a real push to a real phone
# does. Leave it empty and notifications are recorded, retried, and land as dead
# letters; set LINE_MESSAGING_ENABLED=false to have them recorded and resolved
# without being attempted at all.
LINE_CHANNEL_ACCESS_TOKEN=
# The LIFF URL the button on a LINE notification card opens, for example
# https://liff.line.me/ followed by your LIFF id. Public, like VITE_LIFF_ID.
# Leave it empty and every card is sent without a button.
LINE_LIFF_URL=
# Origins the API's CORS filter accepts, comma-separated. The default below
# is the Vite dev server; add the LIFF tunnel's origin only while testing
# through one. Never a wildcard -- these requests carry an Authorization header.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set this only for the one-off ./gradlew bootstrapAdmin command.
ADMIN_BOOTSTRAP_LINE_SUBJECT=
# Payment-proof object storage (ADR-009). Leave PAYMENT_PROOF_ENDPOINT empty
# to talk to AWS S3. compose.yaml already points the api container at its
# object-store service; set http://localhost:9000 here only when running the
# API on the host with ./gradlew bootRun. The bucket is private; the
# object-store service creates it on start.
PAYMENT_PROOF_BUCKET=au-van-payment-proofs
PAYMENT_PROOF_REGION=ap-southeast-1
PAYMENT_PROOF_ENDPOINT=
# Locally, one pair you generate yourself (openssl rand -hex 16, once for
# each): the object-store service takes it as its root credential and the API
# signs with it through the AWS SDK's default credentials chain. The store
# refuses to start with either one blank. The deployed target sets neither
# and uses its task role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
