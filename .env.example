POSTGRES_DB=au_van
POSTGRES_USER=au_van
# Add POSTGRES_PASSWORD to your ignored .env file with a locally generated value.
# Add a base64-encoded 32-byte JWT_SECRET generated with: openssl rand -base64 32
# Add LINE_CHANNEL_ID when testing the live LIFF exchange.
POSTGRES_PASSWORD=
JWT_SECRET=
LINE_CHANNEL_ID=
# Origins the API's CORS filter accepts, comma-separated. The default below
# is the Vite dev server; add the LIFF tunnel's origin only while testing
# through one. Never a wildcard -- these requests carry an Authorization header.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set this only for the one-off ./gradlew bootstrapAdmin command.
ADMIN_BOOTSTRAP_LINE_SUBJECT=
# Payment-proof object storage (ADR-009). Leave PAYMENT_PROOF_ENDPOINT empty
# to talk to AWS S3. compose.yaml already points the api container at its
# MinIO service; set http://localhost:9000 here only when running the API on
# the host with ./gradlew bootRun. The bucket is private and must exist
# already -- see README.md for creating it in MinIO once.
PAYMENT_PROOF_BUCKET=au-van-payment-proofs
PAYMENT_PROOF_REGION=ap-southeast-1
PAYMENT_PROOF_ENDPOINT=
# Read by the AWS SDK's default credentials chain. Locally these are the MinIO
# root credentials (minioadmin/minioadmin unless compose is told otherwise);
# the deployed target sets neither and uses its task role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
